// Prisma Client generator & datasource
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enumerations
enum SubscriptionStatus {
  pending
  accepted
  active
  declined
  cancelled
}

enum NotificationType {
  system
  new_feature
  billing
  marketing
  other
}

enum SettingType {
  string
  number
  boolean
  json
}

// Core user of the application
model User {
  id                      Int            @id @default(autoincrement())
  email                   String         @unique
  name                    String?
  role                    String?
  deletedAt               DateTime?
  notificationPreferences Json?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  notifications           Notification[]
}

// Installed shop. We use `shop` (myshopify domain) as unique key.
model Shop {
  id            Int            @id @default(autoincrement())
  shop          String         @unique
  accessToken   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  subscriptions Subscription[]
  orders        Order[]
  products      Product[]
  customers     Customer[]
}

// Session storage for Shopify auth (offline/online sessions)
model Session {
  id      String @id
  content String @db.Text
  shop    String

  @@index([shop])
}

// Recurring billing subscriptions
model Subscription {
  id              Int                @id @default(autoincrement())
  shop            String
  chargeId        Int                @unique
  planName        String
  price           Float
  status          SubscriptionStatus
  confirmationUrl String
  cancelledAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  shopRef         Shop               @relation(fields: [shop], references: [shop])

  @@index([shop])
}

// Key/value application settings (value stored as serialized JSON string)
model Setting {
  key       String       @id
  value     String
  type      SettingType?
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
}

// User notifications
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Shopify order snapshots
model Order {
  id      String @id
  shop    String
  data    String @db.Text
  status  String
  shopRef Shop   @relation(fields: [shop], references: [shop])

  @@index([shop])
}

// Shopify product snapshots
model Product {
  id      String @id
  shop    String
  data    String @db.Text
  shopRef Shop   @relation(fields: [shop], references: [shop])

  @@index([shop])
}

// Shopify customer snapshots
model Customer {
  id      String @id
  shop    String
  data    String @db.Text
  shopRef Shop   @relation(fields: [shop], references: [shop])

  @@index([shop])
}

// Aggregated customer metrics (future use by analytics)
model CustomerInsight {
  id                 Int      @id @default(autoincrement())
  shop               String
  date               DateTime
  newCustomers       Int
  returningCustomers Int
  createdAt          DateTime @default(now())

  @@index([shop, date])
}

// Audit/trace of analytics calls (optional usage)
model AnalyticsLog {
  id           Int      @id @default(autoincrement())
  shop         String
  userId       String
  endpoint     String
  requestData  String   @db.Text
  responseData String   @db.Text
  statusCode   Int
  createdAt    DateTime @default(now())

  @@index([shop])
}
